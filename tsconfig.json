{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitAny": false,
    "target": "ES2022",
    "outDir": "out",
    "lib": ["dom", "ES2022"],
    "types": ["node", "mocha", "chai", "sinon", "@types/sinon-chai"],
    "jsx": "react",
    "sourceMap": true,
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "vscode-languageclient/node": [
        "./node_modules/vscode-languageclient/lib/node/main"
      ],
      "vscode-languageserver/node": [
        "./node_modules/vscode-languageserver/lib/node/main"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "out",
    ".vscode-test",
    "scripts",
    "ext",
    "playwright-report",
    "test-results"
  ]
}
